# BlindSpot Environment Configuration

# Provider Selection (gemini, openai, anthropic, or heuristic)
BLINDSPOT_PROVIDER=heuristic

# Google Gemini API Key (optional if using gemini provider)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI / OpenAI-compatible API Key (optional if using openai provider)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API Key (optional if using anthropic provider)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Web Server Port
PORT=5000
